# Copie para .env.local. Nunca coloque valores reais neste arquivo.

# Público (vai para o navegador; nunca coloque segredo em NEXT_PUBLIC_)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SENTRY_DSN=

# Somente servidor
SUPABASE_SERVICE_ROLE_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
CRON_SECRET=
SENTRY_DSN=

# Opcional: true troca os botões de compra da landing pela lista de espera
WAITLIST_ENABLED=
